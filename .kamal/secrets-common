# Kamal reads this as a Dotenv file — values like ${VAR} are interpolated
# from the environment of the kamal process. CodeMySpec's deploy exports
# all three before running bin/deploy.
#
# App secrets never pass through here — they travel as ciphertext in the
# image (envs/<env>.enc.env) and SOPS_AGE_KEY opens them at boot.

KAMAL_REGISTRY_USERNAME=${KAMAL_REGISTRY_USERNAME}
KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD}
SOPS_AGE_KEY=${SOPS_AGE_KEY}
