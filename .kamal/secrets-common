# Kamal reads this as a Dotenv file — values like ${VAR} are interpolated
# from the environment of the kamal process. Populate the env first via
# scripts/deploy or scripts/deploy-uat, which source from AWS SSM Parameter
# Store (/metric_flow/<env>/*) and from `gh auth token` for the registry.
#
# Direct `kamal deploy` invocation will fail unless these env vars are
# already exported. Always go through the scripts.
#
# Kamal 2 looks for .kamal/secrets-common as the cross-destination fallback;
# it's chosen over .kamal/secrets so prod and UAT share the same template.

KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD}
DATABASE_URL=${DATABASE_URL}
SECRET_KEY_BASE=${SECRET_KEY_BASE}
PHX_HOST=${PHX_HOST}
PHX_SERVER=${PHX_SERVER}
CLOAK_KEY=${CLOAK_KEY}
SENTRY_DSN=${SENTRY_DSN}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
RESEND_API_KEY=${RESEND_API_KEY}
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
GOOGLE_ADS_DEVELOPER_TOKEN=${GOOGLE_ADS_DEVELOPER_TOKEN}
GOOGLE_ADS_LOGIN_CUSTOMER_ID=${GOOGLE_ADS_LOGIN_CUSTOMER_ID}
FACEBOOK_APP_ID=${FACEBOOK_APP_ID}
FACEBOOK_APP_SECRET=${FACEBOOK_APP_SECRET}
QUICKBOOKS_CLIENT_ID=${QUICKBOOKS_CLIENT_ID}
QUICKBOOKS_CLIENT_SECRET=${QUICKBOOKS_CLIENT_SECRET}
QUICKBOOKS_API_URL=${QUICKBOOKS_API_URL}
