#!/usr/bin/env bash
# Deploy MetricFlow UAT to the Hetzner UAT box.
#
# Same flow as scripts/deploy: the container fetches app secrets from
# /metric_flow/uat/* via MetricFlow.Secrets.load!/1 at boot. This
# script only passes AWS bootstrap creds — no app secrets in the
# operator's shell.

set -euo pipefail

REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)
DEVOPS_ENV="${DEVOPS_ENV:-$HOME/Documents/github/devops/.env}"

cd "$REPO_ROOT"

if [[ -n "$(git status --porcelain)" ]]; then
  echo "ERROR: working tree has uncommitted changes." >&2
  git status --short >&2
  exit 1
fi

SHA=$(git rev-parse HEAD)
BRANCH=$(git rev-parse --abbrev-ref HEAD)

echo "==> pushing $BRANCH ($SHA) to origin..."
git push origin "$BRANCH"

echo "==> waiting for GitHub Actions build to finish..."
sleep 5
RUN_ID=$(gh run list --workflow=build.yml --branch="$BRANCH" --limit=1 --json databaseId --jq '.[0].databaseId')
[[ -n "$RUN_ID" ]] || { echo "no workflow run found" >&2; exit 1; }
gh run watch "$RUN_ID" --exit-status --interval 10

AWS_ACCESS_KEY_ID=$(awk -F= '/^HETZNER_SECRETS_UAT_AWS_ACCESS_KEY_ID=/{print $2}' "$DEVOPS_ENV")
AWS_SECRET_ACCESS_KEY=$(awk -F= '/^HETZNER_SECRETS_UAT_AWS_SECRET_ACCESS_KEY=/{print $2}' "$DEVOPS_ENV")
[[ -n "$AWS_ACCESS_KEY_ID" && -n "$AWS_SECRET_ACCESS_KEY" ]] || {
  echo "ERROR: HETZNER_SECRETS_UAT_AWS_* not found in $DEVOPS_ENV" >&2
  exit 1
}

export KAMAL_REGISTRY_PASSWORD AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
KAMAL_REGISTRY_PASSWORD=$(gh auth token)

kamal deploy -d uat --skip-push --version="$SHA" "$@"

echo "==> Done: https://uat.metric-flow.app"
