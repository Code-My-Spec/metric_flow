# MetricFlow env schema — used by varlock IN DEV ONLY for schema
# validation, redaction in operator output, and leak scanning.
#
# Values resolve from local .env files (.env, .env.dev, .env.test) which
# are gitignored. The schema itself is committed.
#
# In UAT/prod the runtime app fetches its own secrets from AWS SSM
# Parameter Store via `ex_aws_ssm` at boot in `config/runtime.exs` —
# varlock is NOT in the production deploy path. See
# priv/knowledge/devops/secrets-runtime.md for the prod/uat architecture
# and priv/knowledge/devops/varlock.md for the dev workflow.

# @env-spec=v1
# @defaultRequired=infer
# @defaultSensitive=false
# ---

# Core Phoenix runtime
# @sensitive
DATABASE_URL=

# @sensitive
SECRET_KEY_BASE=

# @sensitive
CLOAK_KEY=

PHX_HOST=
PHX_SERVER=

# Observability
# @sensitive
SENTRY_DSN=

# Third-party APIs
# @sensitive
ANTHROPIC_API_KEY=

# @sensitive
RESEND_API_KEY=

# Google OAuth + Ads
# OAuth client IDs are technically public (they appear in browser
# JavaScript for the OAuth redirect flow) but are still rotatable and
# shouldn't end up in transcripts — mark @sensitive for redaction.
# @sensitive
GOOGLE_CLIENT_ID=
# @sensitive
GOOGLE_CLIENT_SECRET=
# @sensitive
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Facebook OAuth — same logic as Google (App ID is "public" but rotatable)
# @sensitive
FACEBOOK_APP_ID=
# @sensitive
FACEBOOK_APP_SECRET=

# QuickBooks OAuth
QUICKBOOKS_CLIENT_ID=
# @sensitive
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_API_URL=

# GitHub OAuth (dev convenience for local OAuth flow testing)
GITHUB_CLIENT_ID=
# @sensitive
GITHUB_CLIENT_SECRET=

# Cloudflare Tunnel — dev only (named tunnel for dev.metric-flow.app)
# @sensitive
CLOUDFLARE_TUNNEL_SECRET=

# Cloudflare API token (dev: white-label custom-domain feature DNS edits)
# @sensitive
CLOUDFLARE_API_TOKEN=

# === CodeMySpec framework (dev only) ==========================================
CODEMYSPEC_URL=
CODEMYSPEC_PROJECT_ID=
# @sensitive
CODEMYSPEC_CLIENT_ID=
# @sensitive
CODEMYSPEC_CLIENT_SECRET=

# === Test fixtures and provider sandboxes (dev/test only) =====================
# Test access tokens for hitting provider sandboxes during ExUnit runs.
# Not needed in prod (the app fetches user-scoped tokens via OAuth).

# @sensitive
FACEBOOK_TEST_ACCESS_TOKEN=
FACEBOOK_TEST_AD_ACCOUNT_ID=

# @sensitive
GOOGLE_TEST_ACCESS_TOKEN=
# @sensitive
GOOGLE_TEST_REFRESH_TOKEN=
GOOGLE_ADS_TEST_CUSTOMER_ID=
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_MANAGER_ACCOUNT_ID=

# @sensitive
QUICKBOOKS_TEST_ACCESS_TOKEN=
QUICKBOOKS_TEST_INCOME_ACCOUNT_ID=
QUICKBOOKS_TEST_REALM_ID=

# === Mailgun (legacy; replaced by Resend, kept for old integration tests) ====
# @sensitive
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# === Stripe (billing — webhook tests run locally via stripe trigger) =========
# @sensitive
STRIPE_SECRET_KEY=
# @sensitive
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
